rules_version = '2';

// Security Rules for Telegram Bot Dashboard
// All data access is done via Cloud Functions using Admin SDK,
// which bypasses these rules. Client-side access is not needed.

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default: Deny all access
    // Cloud Functions use Admin SDK which bypasses these rules
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Groups collection - only accessible via Cloud Functions
    match /groups/{groupId} {
      allow read, write: if false;
      
      // History subcollection
      match /history/{historyId} {
        allow read, write: if false;
      }
    }
  }
}
